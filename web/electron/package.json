{
  "name": "agentnexus-desktop-electron",
  "productName": "AgentNexus",
  "version": "0.12.0-dev.0",
  "description": "AgentNexus desktop shell (Electron edition) - a thin native wrapper around the server-served web UI.",
  "private": true,
  "main": "src/main.js",
  "homepage": "https://github.com/K4y2020/AgentNexus",
  "repository": {
    "type": "git",
    "url": "https://github.com/K4y2020/AgentNexus.git"
  },
  "author": {
    "name": "K4y2020",
    "url": "https://github.com/K4y2020"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac:release": "OMNIGENT_NOTARIZE_DMG=true electron-builder --mac -c.mac.notarize=true -c.dmg.sign=true",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win zip",
    "build:overlay": "pnpm --filter web run build:overlay",
    "predev": "pnpm run build:overlay",
    "prestart": "pnpm run build:overlay",
    "prebuild": "pnpm run build:overlay",
    "prebuild:mac": "pnpm run build:overlay",
    "prebuild:mac:release": "pnpm run build:overlay",
    "prebuild:linux": "pnpm run build:overlay",
    "prebuild:win": "pnpm run build:overlay"
  },
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^26.0.0",
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "ai.agentnexus.desktop",
    "productName": "AgentNexus",
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "AgentNexus session link",
        "schemes": [
          "agentnexus",
          "agentnexus"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/K4y2020/AgentNexus/releases/latest/download/"
      }
    ],
    "afterPack": "build/afterPack.js",
    "afterAllArtifactBuild": "build/afterAllArtifactBuild.js",
    "files": [
      "src/**/*",
      "setup/**/*",
      "find/**/*",
      "return-banner/**/*",
      "icons/**/*",
      "overlay/**/*"
    ],
    "extraResources": [
      {
        "from": "../platform-assets",
        "to": "platform-assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icons/icon.icns",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "signing/entitlements.mac.plist",
      "entitlementsInherit": "signing/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "AgentNexus uses the microphone for voice dictation in the message composer.",
        "CFBundleIconName": "AppIcon"
      },
      "gatekeeperAssess": false,
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "https://github.com/K4y2020/AgentNexus/releases/latest/download/"
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "background": "dmg/background.tiff",
      "window": {
        "width": 640,
        "height": 465
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 170,
          "y": 100
        },
        {
          "x": 470,
          "y": 100,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "category": "Development",
      "maintainer": "K4y2020",
      "target": [
        "AppImage",
        "deb"
      ],
      "publish": [
        {
          "provider": "generic",
          "url": "https://github.com/K4y2020/AgentNexus/releases/latest/download/"
        }
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}-win.${ext}",
      "publish": [
        {
          "provider": "generic",
          "url": "https://github.com/K4y2020/AgentNexus/releases/latest/download/"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "uninstallDisplayName": "${productName} ${version}",
      "shortcutName": "AgentNexus",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.3.0"
  }
}
