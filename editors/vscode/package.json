{
  "name": "agentnexus-vscode",
  "displayName": "AgentNexus",
  "description": "Open your running local AgentNexus server inside VS Code, in an editor-beside iframe.",
  "version": "0.1.0",
  "publisher": "databricks",
  "license": "Apache-2.0",
  "icon": "media/agentnexus-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentnexus-ai/agentnexus.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "AgentNexus",
      "properties": {
        "agentnexus.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Manual AgentNexus server URL override for a **localhost** server (e.g. `http://127.0.0.1:6767`). Leave empty to auto-discover a locally running AgentNexus server. Non-localhost URLs are not supported in this build."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentnexus-container",
          "title": "AgentNexus",
          "icon": "media/agentnexus-icon.svg"
        }
      ]
    },
    "views": {
      "agentnexus-container": [
        {
          "type": "tree",
          "id": "agentnexus.home",
          "name": "AgentNexus"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentnexus.home",
        "contents": "Open the running AgentNexus server UI in an editor tab.\n[Open AgentNexus](command:agentnexus.open)\nStart a local server with `agentnexus server`, or set `agentnexus.serverUrl` to a localhost URL."
      }
    ],
    "commands": [
      {
        "command": "agentnexus.open",
        "title": "AgentNexus: Open",
        "icon": "media/agentnexus-icon.svg"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agentnexus.open",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "agentnexus.open"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.5",
    "vitest": "^3.2.6"
  }
}
